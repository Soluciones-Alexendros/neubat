{
  "version": "2.0.0",
  "hostname": "neubat-base",
  "username": "neubat",
  "password": "neubat",
  "disk": "/dev/sda",
  "desktop": "none",
  "packages": [
    "htop",
    "btop",
    "fastfetch",
    "git",
    "curl",
    "wget",
    "okular"
  ],
  "services": [
    "NetworkManager",
    "sshd"
  ],
  "timezone": "Europe/Madrid",
  "locale": "es_ES.UTF-8",
  "keyboard": "es",
  "encryption": {
    "enabled": false,
    "method": "keyfile",
    "passphrase": "",
    "cipher": "aes-xts-plain64",
    "key_size": 512
  },
  "snapshots": {
    "enabled": false,
    "cleanup": {
      "hourly": 5,
      "daily": 7,
      "weekly": 2,
      "monthly": 2
    }
  }
}
